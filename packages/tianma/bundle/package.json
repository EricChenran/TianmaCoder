{
  "name": "@tianma/dsh-bundle",
  "description": "Tianma profile bundle: patch rows adopting ZCode-derived quality defaults and plugins over dsh-base",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EricChenran/TianmaCoder.git",
    "directory": "packages/tianma/bundle"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@tianma/dsh-behavioral-guidelines": "workspace:^",
    "@tianma/dsh-compaction-recency-pruner": "workspace:^",
    "@tianma/dsh-compaction-summarize": "workspace:^"
  }
}
